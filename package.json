{
  "name": "svg-flags",
  "version": "1.1.0",
  "description": "SVG country flags for React (web) and React Native / Expo, with embedded SVG strings for headless use",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "react-native": "dist/index.native.js",
  "exports": {
    ".": {
      "react-native": {
        "import": "./dist/index.native.esm.js",
        "require": "./dist/index.native.js",
        "default": "./dist/index.native.js"
      },
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "svg-flags": "scripts/copy-flags-to-public.js"
  },
  "files": [
    "dist",
    "flags",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/generate-country-list.js && node scripts/embed-svg-content.js && npx rollup -c",
    "dev": "npx rollup -c -w",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "node test/test.js",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write src/**/*.{ts,tsx}",
    "type-check": "tsc --noEmit",
    "generate-countries": "node scripts/generate-country-list.js",
    "setup-flags": "node scripts/copy-flags-to-public.js",
    "embed-flags": "node scripts/embed-svg-content.js"
  },
  "keywords": [
    "svg",
    "flags",
    "country",
    "national",
    "icons",
    "react",
    "react-native",
    "expo",
    "react-native-svg",
    "vue",
    "angular",
    "web",
    "frontend"
  ],
  "author": {
    "name": "Nikos Pountzas",
    "email": "nikos@pountzas.gr"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pountzas/svg-flags.git"
  },
  "bugs": {
    "url": "https://github.com/pountzas/svg-flags/issues"
  },
  "homepage": "https://github.com/pountzas/svg-flags#readme",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-terser": "^0.4.0",
    "@rollup/plugin-typescript": "^11.0.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/jest": "^29.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "prettier": "^3.0.0",
    "rimraf": "^6.1.3",
    "rollup": "^3.30.0",
    "rollup-plugin-dts": "^5.0.0",
    "semantic-release": "^25.0.9",
    "tslib": "^2.6.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0",
    "react-native-svg": ">=12.0.0"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "js-yaml@3": "3.15.1",
    "js-yaml@4": "4.3.1",
    "brace-expansion@1": "1.1.18",
    "brace-expansion@2": "2.1.4",
    "@babel/core": "7.29.6",
    "serialize-javascript": "7.0.5",
    "picomatch@2": "2.3.2",
    "picomatch@4": "4.0.4",
    "flatted": "3.4.2",
    "minimatch@3": "3.1.4",
    "minimatch@5": "5.1.8",
    "minimatch@9": "9.0.7",
    "glob@10": "10.5.0",
    "ajv": "6.15.0"
  }
}
